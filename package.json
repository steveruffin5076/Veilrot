{
  "name": "veilrot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veilrot — isometric tactical RPG (browser-first, DEC-004)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "demo": "npm run build && npm run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "check:payload-budget": "node scripts/check-payload-budget.mjs",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^9.39.0",
    "playwright": "^1.48.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
